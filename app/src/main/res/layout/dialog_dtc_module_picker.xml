<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/dtc_picker_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <!-- Shortcut into the CAN header (Diagnostic Request ID) mapping screen, with its hint
         beside it so it reads as "what this button does". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pref.dtc.select_modules.can_headers_hint"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />

        <Button
            android:id="@+id/dtc_picker_can_headers"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp"
            android:text="@string/pref.dtc.select_modules.can_headers"
            android:textColor="@color/rainbow_indigo" />
    </LinearLayout>

    <!-- Height-capped so a long module list scrolls instead of pushing the buttons out of view. -->
    <org.obd.graphs.preferences.dtc.MaxHeightListView
        android:id="@+id/dtc_picker_modules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarSize="6dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/dtc_module_list_scrollbar_thumb"
        android:scrollbars="vertical" />

    <!-- Own button bar (not the AlertDialog's) so the three buttons never auto-stack vertically. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/dtc_picker_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pref.dtc.select_modules.cancel" />

        <Button
            android:id="@+id/dtc_picker_toggle_all"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pref.dtc.select_modules.deselect_all" />

        <Button
            android:id="@+id/dtc_picker_confirm"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/dtc_module_picker_confirm_text" />
    </LinearLayout>

</LinearLayout>
