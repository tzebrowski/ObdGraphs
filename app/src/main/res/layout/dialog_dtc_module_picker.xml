<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/dtc_picker_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <!-- Shortcut into the CAN header (Diagnostic Request ID) mapping screen, with its hint
         beside it so it reads as "what this button does". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pref.dtc.select_modules.can_headers_hint"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />

        <Button
            android:id="@+id/dtc_picker_can_headers"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp"
            android:text="@string/pref.dtc.select_modules.can_headers"
            android:textColor="@color/rainbow_indigo" />
    </LinearLayout>

    <!-- What the per-module OBD-II switch does. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/pref.dtc.select_modules.obd_hint"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp" />

    <!-- Bulk (de)selection sits with the list rather than in the button bar: three buttons sharing
         the bar's width broke "Odznacz wszystkie" mid-word in Polish. -->
    <Button
        android:id="@+id/dtc_picker_toggle_all"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="0dp"
        android:text="@string/pref.dtc.select_modules.deselect_all"
        android:textColor="@color/rainbow_indigo" />

    <!-- Height-capped so a long module list scrolls instead of pushing the buttons out of view. -->
    <org.obd.graphs.preferences.dtc.MaxHeightListView
        android:id="@+id/dtc_picker_modules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarSize="6dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/dtc_module_list_scrollbar_thumb"
        android:scrollbars="vertical" />

    <!-- Freeze frames for this read only (Read flow), ticked as the "Read freeze frame data" setting is. Gone in the
         Clear flow. The divider keeps it from reading as one more module row under a cut-off list. -->
    <LinearLayout
        android:id="@+id/dtc_picker_snapshots_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/divider_color" />

        <CheckBox
            android:id="@+id/dtc_picker_snapshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref.dtc.read_snapshots" />

        <!-- What it costs, the setting's own summary. Indented to the checkbox label. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:text="@string/pref.dtc.read_snapshots_summary"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Own button bar (not the AlertDialog's) so the buttons never auto-stack vertically. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/dtc_picker_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref.dtc.select_modules.cancel" />

        <Button
            android:id="@+id/dtc_picker_confirm"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dtc_module_picker_confirm_text" />
    </LinearLayout>

</LinearLayout>
