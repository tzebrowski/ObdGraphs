<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">
    <TextView
        android:id="@+id/dtc_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="80dp"
        android:padding="8dp"
        android:text="@string/pref.dtc.code"
        android:textColor="@color/gray_light"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dtc_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:paddingBottom="8dp"
        android:text="@string/pref.dtc.description"
        android:textAllCaps="false"
        android:textColor="@color/gray_light"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/dtc_expand_indicator"
        app:layout_constraintStart_toEndOf="@+id/dtc_value"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tells the row can be expanded; turned upside down while it is. -->
    <ImageView
        android:id="@+id/dtc_expand_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/dtc.row.expand"
        android:src="@drawable/dtc_expand_more"
        app:tint="@color/dialog_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- State chips from the DTC status byte, in one line below the description (never shorter than the code: same
         text size and padding). The row is a plain top-down stack - description, chips, details, divider - because a
         barrier here resolved wrongly once a row was expanded and pushed the chips far down. -->
    <LinearLayout
        android:id="@+id/dtc_badges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dtc_description">

        <!-- Chips are spaced by their end margin, so any of them can be gone. "New" comes from the DTC history. -->
        <TextView
            android:id="@+id/dtc_new_badge"
            style="@style/DtcBadge"
            android:layout_marginEnd="8dp"
            android:text="@string/dtc.history.new"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dtc_state_badge"
            style="@style/DtcBadge"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dtc_mil_badge"
            style="@style/DtcBadge"
            android:layout_marginEnd="8dp"
            android:text="@string/dtc.state.mil"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dtc_permanent_badge"
            style="@style/DtcBadge"
            android:text="@string/dtc.state.permanent"
            android:visibility="gone" />

        <!-- A "no longer reported" row: when its code was last reported, in place of the state chips. -->
        <TextView
            android:id="@+id/dtc_gone_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@color/dialog_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/dtc_state_history"
            app:drawableTint="@color/dialog_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dtc_expanded_details_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dtc_value"
        app:layout_constraintTop_toBottomOf="@+id/dtc_badges">

        <!-- What the state chips mean, one line each (the chips' colour alone does not say it). -->
        <TextView
            android:id="@+id/dtc_detail_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- DTC history (per vehicle): first / last reported and in how many scans of its module. A panel of its own
             with a green edge (the "New" colour), above the decoded details, so it is not read as one more status line. -->
        <LinearLayout
            android:id="@+id/dtc_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dtc_history_panel"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/dtc.history.title"
                android:textColor="@color/dtc_history_new"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/dtc_state_history"
                app:drawableTint="@color/dtc_history_new" />

            <TextView
                android:id="@+id/dtc_detail_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dtc_detail_system_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dtc_detail_hex_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/dtc_snapshot_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface_variant"
            android:padding="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dtc.freeze_frame_data"
                android:textStyle="bold"
                android:textColor="@color/rainbow_indigo"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/dtc_detail_snapshot_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- Values of the dtcFollowUp requests (e.g. UDS 19 06 extended data): occurrences, cycles to MIL off. -->
        <LinearLayout
            android:id="@+id/dtc_extended_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface_variant"
            android:padding="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dtc.extended_data"
                android:textStyle="bold"
                android:textColor="@color/rainbow_indigo"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/dtc_detail_extended_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/dtc_action_search_web"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dtc.action_google_issue"
                android:textColor="@color/rainbow_indigo"
                android:textSize="12sp" />

            <Button
                android:id="@+id/dtc_action_copy_code"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dtc.action_copy"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/item_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dtc_expanded_details_container" />

</androidx.constraintlayout.widget.ConstraintLayout>