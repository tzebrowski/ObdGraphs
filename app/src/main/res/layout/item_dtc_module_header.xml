<?xml version="1.0" encoding="utf-8"?>
<!-- Module header: name + code count, a summary of its codes (state icons with counts, MIL, new; a check when clean)
     and an arrow. Tapping it collapses / expands the module's rows; the summary is what a collapsed module shows. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/dtc_module_header_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:letterSpacing="0.05"
        android:textAllCaps="true"
        android:textColor="@color/rainbow_indigo"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Filled in code: one mini chip per indicator. -->
    <LinearLayout
        android:id="@+id/dtc_module_header_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <ImageView
        android:id="@+id/dtc_module_header_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/dtc_expand_more"
        app:tint="@color/dialog_text_secondary" />
</LinearLayout>
